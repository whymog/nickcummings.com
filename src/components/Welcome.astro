---
import background from '../assets/background.jpg';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>
		<section class="flex flex-col items-center justify-center p-4">
			<div class="flex flex-col gap-4 items-start justify-center rounded-2xl bg-white/25 px-4 md:px-8 lg:px-24 py-8 md:py-12 lg:py-16">
				<div>The all-new 2026</div>
				<h1 class="py-1 text-3xl sm:text-5xl font-bold drop-shadow-md bg-linear-to-r from-[#9E0DE6] to-[#3078BC] bg-clip-text text-transparent">
					Nick Cummings dot com
				</h1>
				<div class="w-full text-center">✨ a dot com for the modern era ✨</div>
				<hr class="w-full mt-4 mb-8 border-black/10 border-t" />
				<div>If you're looking for my <a class="font-medium hover:text-white transition-colors duration-200" href="https://whymog.net/blog" target="_blank" rel="noopener noreferrer">blog</a> or <a class="font-medium hover:text-white transition-colors duration-200" href="https://whymog.net/games" target="_blank" rel="noopener noreferrer">portfolio</a>, you'll find them at <a class="font-medium hover:text-white transition-colors duration-200" href="https://whymog.net/" target="_blank" rel="noopener noreferrer">whymog.net</a>.</div>
				<section id="links" class="inline">
					<span>You can find me on</span>
					<a class="font-medium hover:text-white transition-colors duration-200" href="https://bsky.app/profile/nickcummings.com" target="_blank" rel="noopener noreferrer">
						<svg class="inline w-6 h-6 mb-1" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M111.8 62.2C170.2 105.9 233 194.7 256 242.4c23-47.6 85.8-136.4 144.2-180.2c42.1-31.6 110.3-56 110.3 21.8c0 15.5-8.9 130.5-14.1 149.2C478.2 298 412 314.6 353.1 304.5c102.9 17.5 129.1 75.5 72.5 133.5c-107.4 110.2-154.3-27.6-166.3-62.9l0 0c-1.7-4.9-2.6-7.8-3.3-7.8s-1.6 3-3.3 7.8l0 0c-12 35.3-59 173.1-166.3 62.9c-56.5-58-30.4-116 72.5-133.5C100 314.6 33.8 298 15.7 233.1C10.4 214.4 1.5 99.4 1.5 83.9c0-77.8 68.2-53.4 110.3-21.8z"></path></svg>
						Bluesky 
					</a>
					<span>and</span>
					<a class="font-medium hover:text-white transition-colors duration-200" href="https://linkedin.com/in/nickcummings" target="_blank" rel="noopener noreferrer">
						<svg class="inline w-6 h-6 mb-1" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="200px" width="200px" xmlns="http://www.w3.org/2000/svg"><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path></svg> 
						LinkedIn.
					</a>
				</section>
				<div>Okay, see you soon!</div>
			</div>
		</section>
	</main>
</div>

<style>
	#background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		opacity: 0.5;

		background-size: contain;
		background-position: center;
		background-repeat: no-repeat;
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}
</style>
